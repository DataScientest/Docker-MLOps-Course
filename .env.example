# Copiez ce fichier en .env et ajustez si besoin.
# Compose lit automatiquement .env pour interpoler ${...} dans les fichiers compose.

# Port de la machine hote sur lequel l'API est exposee.
API_PORT=8000

# Adresse de la base vectorielle, telle que l'API la joint sur le reseau Docker.
QDRANT_URL=http://qdrant:6333
